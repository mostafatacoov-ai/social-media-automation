{
  "name": "social-studio",
  "version": "0.1.0",
  "private": true,
  "description": "White-label social media marketing platform — AI posts, images, reels, marketing plans and multi-platform publishing",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "media": "cd media-service && python -m uvicorn main:app --port 8000 --reload",
    "media:install": "cd media-service && pip install -r requirements.txt",
    "fonts": "cd media-service && python fetch_fonts.py"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "lucide-react": "^0.544.0",
    "next": "^15.5.6",
    "node-cron": "^3.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.4",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prisma": "^6.16.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  }
}
