# ===== Social Studio environment =====
# Copy this file to .env and adjust values.

# SQLite database file (default works out of the box)
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies — generate a new one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# Key used to encrypt AI API keys + OAuth tokens at rest (32 bytes hex = 64 chars)
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY="change-me-64-hex-chars"

# Python media service (image templates, reels, TTS)
MEDIA_SERVICE_URL="http://127.0.0.1:8000"

# Where generated/uploaded media is stored (relative to project root)
MEDIA_DIR="./data/media"

# Public base URL of THIS app. Needed for platforms that fetch media by URL
# (Instagram container API, TikTok PULL_FROM_URL). When running locally and
# publishing to those platforms, set this to a public tunnel URL (e.g. ngrok).
PUBLIC_BASE_URL="http://localhost:3000"
